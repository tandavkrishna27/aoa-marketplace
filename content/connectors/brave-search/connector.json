{
  "id": "brave-search",
  "displayName": "Brave Search",
  "description": "Web and local search via the Brave Search API. Brave's official MCP server, run locally over stdio and authenticated with a Brave Search API key (BRAVE_API_KEY).",
  "serverName": "brave-search",
  "transport": "stdio",
  "command": "npx",
  "args": ["-y", "@brave/brave-search-mcp-server", "--transport", "stdio"],
  "envTemplateKeys": ["BRAVE_API_KEY"],
  "requiresSecret": true,
  "requiresOAuth": false,
  "secretLabel": "Brave Search API key",
  "docsUrl": "https://github.com/brave/brave-search-mcp-server",
  "trust": { "tier": "verified" }
}
